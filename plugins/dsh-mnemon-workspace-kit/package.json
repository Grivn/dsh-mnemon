{
  "name": "dsh-mnemon-workspace-kit",
  "version": "0.1.0",
  "description": "Scoped record persistence and page utilities for independent memory Sources.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./dsh": {
      "types": "./lib/dsh.d.ts",
      "default": "./lib/dsh.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "dsh-mnemon": "^0.5.5",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1 || ^0.1.5-rc.1",

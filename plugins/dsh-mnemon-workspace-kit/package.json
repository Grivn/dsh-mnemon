    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-rc.1 || ^0.1.5-rc.1",
    "@deepseek-ai/dsh-session-title": "^0.1.2-rc.1 || ^0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.0.0",
    "dsh-mnemon": "^0.5.5",
    "dsh-mnemon-strategy-default-three-tier": "^0.5.4",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.0.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-query": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@types/proper-lockfile": "^4.1.4",
    "@deepseek-ai/dsh-workspace": "0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session-title": "0.1.5-rc.1"
